# Firebase 설정 (Firebase 콘솔 > 프로젝트 설정 > 앱 > SDK 구성에서 복사)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Gemini API 키 (GitHub Secret: MOOVEST 에 저장된 값)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Alpha Vantage API 키 (선택 사항 - 없으면 Gemini가 기본 지식으로 분석)
# https://www.alphavantage.co/support/#api-key 에서 무료 발급
VITE_ALPHA_VANTAGE_KEY=
