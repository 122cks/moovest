rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 랭킹 컬렉션: 누구나 읽기 가능, 쓰기는 인증된 사용자(서버)만
    match /rankings/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Functions 서비스 계정만 쓰기 가능
    }

    // 기타 모든 컬렉션 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
